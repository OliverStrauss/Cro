<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CroApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every test class here spins up its own WebApplicationFactory<Program> against the
         same shared Cosmos DB emulator / Azurite instance in CI. xunit parallelizes test
         collections (one per class) by default, so without this, ~9 classes hit the emulator
         concurrently on a 4-CPU GitHub-hosted runner - observed both as the emulator process
         crashing outright under load and as scattered transient 500s from otherwise-unrelated
         tests' POST /users calls. Serializing collections trades some CI wall-clock time for
         not hammering the one shared emulator instance from many directions at once. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>