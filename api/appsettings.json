{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "DatabaseName": "CroApp",
    "UsersContainerName": "Users",
    "WaypointsContainerName": "Waypoints",
    "BirdsContainerName": "Birds"
  },
  "BlobStorage": {
    "ProfilePicturesContainerName": "profile-pictures"
  },
  "Jwt": {
    "Issuer": "CroApp.Api",
    "Audience": "CroApp.App",
    "ExpiryMinutes": 60
  }
}
